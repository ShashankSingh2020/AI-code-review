APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME="AI Code Review + GitHub Repository Analyst"

# Template URL for Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://neondb_owner:<your_password>@ep-icy-sunset-attl50ty-pooler.c-9.us-east-1.aws.neon.tech/neondb?ssl=require

# Sandbox limits
MAX_REPO_SIZE_MB=50
MAX_REPO_FILES=500
MAX_SINGLE_FILE_BYTES=512000
CLONE_TIMEOUT_SECONDS=45
PIPELINE_TIMEOUT_SECONDS=300
TEMP_STORAGE_PATH=./storage/temp_repos

# LLM Configuration
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash